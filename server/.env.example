# Copy to server/.env and fill in. server/.env is git-ignored and must stay that way.
# This file is the ONLY place an AI provider key exists. It is never shipped to
# the extension and never returned in an API response.

NODE_ENV=development
PORT=8787

# AI provider (Groq for v1). Get a key from the provider's console.
AI_API_KEY=
# Model ids change: llama-3.3-70b-versatile was decommissioned during this
# project. Run "npm run models" to see what your key can actually use.
AI_MODEL=openai/gpt-oss-20b
# The knowledge stages need long answers, and a per-minute token budget - not
# intelligence - is what decides how they have to be asked for. Run
# "npm run limits" to see what each model on your key allows. Note that a
# wrapper model can advertise a large budget and then route to a smaller one,
# so the figure that matters is the one in the error you get, not the header.
AI_MODEL_REASONING=openai/gpt-oss-120b

# Your unpacked extension's origin, e.g. chrome-extension://abcdefghijklmnop
# Chrome assigns this id when you load the extension in Phase 2.
ALLOWED_ORIGINS=

# Default weekly study budget in hours (overridable per run from the UI).
WEEKLY_HOURS=25

# --- Notion export (optional) ---------------------------------------------
# Turns the roadmap into a Notion page with checkboxes. Leave both blank and the
# export is simply not offered.
#
# 1. notion.so/my-integrations -> New integration -> copy the Internal
#    Integration Secret (starts with ntn_).
# 2. Make a page in Notion to hold roadmaps, open it, then ... -> Connections
#    -> Connect to -> your integration. Without this step Notion returns
#    "Could not find page", because an integration can only see what it is
#    explicitly given.
# 3. Copy that page's id from its URL: the 32 characters before any ?, with or
#    without dashes.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Prompt/response and roadmap cache. Debug data only; never committed.
CACHE_DIR=.cache

# Ceiling on one answer. Prompt + this counts against the per-minute token
# limit, so it must leave room beneath whatever your plan allows.
AI_MAX_TOKENS=3000
