{
  "name": "@brotomap/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brotomap API - holds the AI provider key, runs the roadmap pipeline (built from Phase 5)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "models": "tsx src/scripts/models.ts",
    "typecheck": "tsc -p tsconfig.json",
    "try": "tsx src/scripts/try-understand.ts",
    "try:map": "tsx src/scripts/try-understand.ts --map",
    "limits": "tsx src/scripts/limits.ts",
    "notion": "tsx src/scripts/notion.ts",
    "autostart": "tsx src/scripts/autostart.ts",
    "autostart:remove": "tsx src/scripts/autostart.ts --remove"
  },
  "dependencies": {
    "@brotomap/shared": "*",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.13"
  }
}
